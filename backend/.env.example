# MongoDB connection string
MONGO_URI=mongodb://127.0.0.1:27017/student-dashboard

# Optional API port
PORT=5000

# Optional comma-separated frontend origins allowed to call the API
# CLIENT_ORIGIN=http://localhost:5173,http://localhost:3000

# Trust one reverse proxy hop in deployments such as Nginx/ALB.
# Leave false unless the application is actually behind exactly one trusted proxy hop.
# The proxy must overwrite X-Forwarded-For/X-Forwarded-Host/X-Forwarded-Proto.
TRUST_PROXY=false

# JWT signing secret (use a long random value in real environments)
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters

# Browser session cookie settings
# In production, use COOKIE_SECURE=true with HTTPS. Do not copy the local-development value into production.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Shared Redis REST credentials for distributed login rate limiting.
# Upstash Redis REST is the supported production configuration.
# REDIS_REST_URL=https://<your-db>.upstash.io
# REDIS_REST_TOKEN=<server-side-standard-token>
