{
  "openapi": "3.0.3",
  "info": {
    "title": "Student Dashboard API",
    "version": "1.2.0",
    "description": "REST API for student and faculty authentication, academic records, timetable management, health checks, and session management."
  },
  "servers": [
    {
      "url": "http://localhost:5000",
      "description": "Local development"
    }
  ],
  "tags": [
    {
      "name": "Health",
      "description": "Service and readiness checks"
    },
    {
      "name": "Authentication",
      "description": "CSRF bootstrap and rotating session management"
    },
    {
      "name": "Students",
      "description": "Student accounts and academic summaries"
    },
    {
      "name": "Faculty",
      "description": "Faculty authentication and registration"
    },
    {
      "name": "Attendance",
      "description": "Attendance records and reports"
    },
    {
      "name": "Marks",
      "description": "Student marks"
    },
    {
      "name": "Timetable",
      "description": "Timetable entries"
    }
  ],
  "securitySchemes": {
    "bearerAuth": {
      "type": "http",
      "scheme": "bearer",
      "bearerFormat": "JWT",
      "description": "Trusted non-browser integrations may send an existing JWT."
    },
    "accessCookie": {
      "type": "apiKey",
      "in": "cookie",
      "name": "studentDashboardAuth",
      "description": "HttpOnly access-session cookie used by browser clients."
    },
    "csrfHeader": {
      "type": "apiKey",
      "in": "header",
      "name": "X-CSRF-Token",
      "description": "Required for browser state-changing requests and refresh/logout."
    }
  },
  "components": {
    "schemas": {
      "Error": {
        "type": "object",
        "required": [
          "message"
        ],
        "properties": {
          "message": {
            "type": "string"
          }
        }
      },
      "Student": {
        "type": "object",
        "properties": {
          "_id": {
            "type": "string",
            "example": "507f1f77bcf86cd799439011"
          },
          "name": {
            "type": "string",
            "minLength": 2,
            "maxLength": 100
          },
          "rollNumber": {
            "type": "string",
            "example": "DEMO-CSE-001"
          },
          "department": {
            "type": "string",
            "minLength": 2,
            "maxLength": 100
          },
          "year": {
            "type": "integer",
            "minimum": 1,
            "maximum": 8
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "StudentCreate": {
        "type": "object",
        "required": [
          "name",
          "rollNumber",
          "department",
          "year",
          "password"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 2,
            "maxLength": 100
          },
          "rollNumber": {
            "type": "string"
          },
          "department": {
            "type": "string",
            "minLength": 2,
            "maxLength": 100
          },
          "year": {
            "type": "integer",
            "minimum": 1,
            "maximum": 8
          },
          "password": {
            "type": "string",
            "minLength": 8
          }
        }
      },
      "StudentUpdate": {
        "type": "object",
        "minProperties": 1,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 2,
            "maxLength": 100
          },
          "rollNumber": {
            "type": "string"
          },
          "department": {
            "type": "string",
            "minLength": 2,
            "maxLength": 100
          },
          "year": {
            "type": "integer",
            "minimum": 1,
            "maximum": 8
          },
          "password": {
            "type": "string",
            "minLength": 8
          }
        }
      },
      "StudentLogin": {
        "type": "object",
        "required": [
          "rollNumber",
          "password"
        ],
        "properties": {
          "rollNumber": {
            "type": "string"
          },
          "password": {
            "type": "string",
            "minLength": 8
          }
        }
      },
      "FacultyLogin": {
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          },
          "password": {
            "type": "string"
          }
        }
      },
      "FacultyRegister": {
        "type": "object",
        "required": [
          "name",
          "email",
          "password"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 2,
            "maxLength": 100
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "password": {
            "type": "string",
            "minLength": 8
          }
        }
      },
      "AttendanceInput": {
        "type": "object",
        "required": [
          "studentId",
          "subject",
          "status",
          "date"
        ],
        "properties": {
          "studentId": {
            "type": "string"
          },
          "subject": {
            "type": "string",
            "minLength": 2,
            "maxLength": 80
          },
          "status": {
            "type": "string",
            "enum": [
              "present",
              "absent"
            ]
          },
          "date": {
            "type": "string",
            "format": "date"
          }
        }
      },
      "AttendanceSummary": {
        "type": "object",
        "properties": {
          "studentId": {
            "type": "string"
          },
          "totalClasses": {
            "type": "integer"
          },
          "present": {
            "type": "integer"
          },
          "percentage": {
            "type": "number"
          }
        }
      },
      "MarksInput": {
        "type": "object",
        "required": [
          "studentId",
          "subject",
          "score"
        ],
        "properties": {
          "studentId": {
            "type": "string"
          },
          "subject": {
            "type": "string",
            "minLength": 2,
            "maxLength": 80
          },
          "score": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          }
        }
      },
      "TimetableInput": {
        "type": "object",
        "required": [
          "day",
          "subject",
          "time"
        ],
        "properties": {
          "day": {
            "type": "string",
            "enum": [
              "monday",
              "tuesday",
              "wednesday",
              "thursday",
              "friday",
              "saturday",
              "sunday"
            ]
          },
          "subject": {
            "type": "string",
            "minLength": 2,
            "maxLength": 80
          },
          "time": {
            "type": "string",
            "example": "10:00 AM"
          }
        }
      }
    },
    "parameters": {
      "StudentId": {
        "name": "id",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string"
        },
        "description": "Student MongoDB ObjectId"
      }
    },
    "responses": {
      "BadRequest": {
        "description": "Invalid request or validation failure",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "Unauthorized": {
        "description": "Authentication required or session invalid",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "Forbidden": {
        "description": "Insufficient permissions or invalid CSRF token",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "NotFound": {
        "description": "Resource or route not found",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "Conflict": {
        "description": "Duplicate resource",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      }
    }
  },
  "paths": {
    "/": {
      "get": {
        "tags": [
          "Health"
        ],
        "summary": "Get service status",
        "responses": {
          "200": {
            "description": "Service running",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "service": {
                      "type": "string"
                    },
                    "status": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "tags": [
          "Health"
        ],
        "summary": "Liveness check",
        "responses": {
          "200": {
            "description": "Service is alive",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "example": "ok"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/health/ready": {
      "get": {
        "tags": [
          "Health"
        ],
        "summary": "Readiness check",
        "responses": {
          "200": {
            "description": "Database and configured rate-limit store are ready"
          },
          "503": {
            "description": "Database or configured rate-limit store is unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/auth/csrf": {
      "get": {
        "tags": [
          "Authentication"
        ],
        "summary": "Issue pre-authentication CSRF cookie",
        "responses": {
          "200": {
            "description": "CSRF token ready"
          }
        }
      }
    },
    "/auth/refresh": {
      "post": {
        "tags": [
          "Authentication"
        ],
        "summary": "Rotate refresh session",
        "security": [
          {
            "accessCookie": [],
            "csrfHeader": []
          }
        ],
        "responses": {
          "200": {
            "description": "Session refreshed"
          },
          "401": {
            "description": "Missing, expired, invalid, or replayed refresh session",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/auth/logout": {
      "post": {
        "tags": [
          "Authentication"
        ],
        "summary": "Revoke current refresh session",
        "security": [
          {
            "accessCookie": [],
            "csrfHeader": []
          }
        ],
        "responses": {
          "204": {
            "description": "Session revoked"
          },
          "500": {
            "description": "Unexpected server error"
          }
        }
      }
    },
    "/students/login": {
      "post": {
        "tags": [
          "Students"
        ],
        "summary": "Student login",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/StudentLogin"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Login successful"
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "429": {
            "description": "Login rate limit exceeded"
          }
        }
      }
    },
    "/students": {
      "post": {
        "tags": [
          "Students"
        ],
        "summary": "Create student",
        "security": [
          {
            "accessCookie": [],
            "csrfHeader": []
          },
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/StudentCreate"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Student created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Student"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          }
        }
      },
      "get": {
        "tags": [
          "Students"
        ],
        "summary": "List students",
        "security": [
          {
            "accessCookie": []
          },
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Student list",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Student"
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          }
        }
      }
    },
    "/students/{id}": {
      "parameters": [
        {
          "$ref": "#/components/parameters/StudentId"
        }
      ],
      "get": {
        "tags": [
          "Students"
        ],
        "summary": "Get student",
        "security": [
          {
            "accessCookie": []
          },
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Student",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Student"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      },
      "put": {
        "tags": [
          "Students"
        ],
        "summary": "Update student",
        "security": [
          {
            "accessCookie": [],
            "csrfHeader": []
          },
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/StudentUpdate"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated student",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Student"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      },
      "delete": {
        "tags": [
          "Students"
        ],
        "summary": "Delete student",
        "security": [
          {
            "accessCookie": [],
            "csrfHeader": []
          },
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Student deleted"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/students/summary/{id}": {
      "parameters": [
        {
          "$ref": "#/components/parameters/StudentId"
        }
      ],
      "get": {
        "tags": [
          "Students"
        ],
        "summary": "Get academic summary for the authenticated student",
        "security": [
          {
            "accessCookie": []
          },
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Academic summary"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
